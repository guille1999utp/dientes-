# Base de datos SQLite local. En producción (Vercel) usa una URL de Turso: libsql://<db>.turso.io
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_AUTH_TOKEN=""

# Contraseña del panel de administración (/admin)
ADMIN_PASSWORD="cambia-esta-contrasena"
# Secreto para firmar la cookie de sesión del admin (cámbialo en producción)
SESSION_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
